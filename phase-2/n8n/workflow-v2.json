      "id": "a1a1a1a1-b2b2-4c3c-d4d4-e5e5e5e5e5e5",
      "name": "Weekly Stats Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        250,
        700
      ]
    },
    {
      "parameters": {
        "jsCode": "// 週報統計：讀取 Static Data 並格式化為 Markdown\nconst staticData = $getWorkflowStaticData('global');\nconst stats = staticData.stats || { totalRequests: 0, users: {} };\nconst rate = staticData.rate || {};\n\nconst now = new Date();\nconst weekStart = new Date(now);\nweekStart.setDate(now.getDate() - 7);\nconst dateRange = weekStart.toISOString().split('T')[0] + ' ~ ' + now.toISOString().split('T')[0];\n\n// 建構使用者排行\nconst userEntries = Object.entries(stats.users || {});\nuserEntries.sort((a, b) => b[1].total - a[1].total);\n\nlet table = '| 排名 | 使用者 | 累計次數 |\\n|------|--------|----------|\\n';\nuserEntries.forEach(([uid, info], idx) => {\n  table += '| ' + (idx + 1) + ' | ' + info.name + ' | ' + info.total + ' |\\n';\n});\n\nconst activeToday = Object.keys(rate).length;\nconst totalUsers = userEntries.length;\n\nconst message = ':bar_chart: **AI 助手週報** (' + dateRange + ')\\n\\n'\n  + '- 累計請求數：**' + stats.totalRequests + '**\\n'\n  + '- 累計使用者數：**' + totalUsers + '**\\n'\n  + '- 今日活躍使用者：**' + activeToday + '**\\n\\n'\n  + '### 使用者排行\\n\\n' + table;\n\nreturn [{ json: { message } }];"
      },
      "id": "b2b2b2b2-c3c3-4d4d-e5e5-f6f6f6f6f6f6",
      "name": "Format Stats Report",
