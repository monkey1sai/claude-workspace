      },
      "id": "7928fe47-7a9f-4cc8-988e-6110938d24f2",
      "name": "Mattermost Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "webhookId": "c21b0d84-1f0e-48c2-b811-6ce96084343c"
    },
    {
      "parameters": {
        "jsCode": "// 提取 Mattermost Outgoing Webhook 的訊息內容\nconst body = $input.first().json.body;\nconst text = body.text || '';\nconst query = text.replace(/@ai-assistant/gi, '').trim();\nconst channelId = body.channel_id;\nconst userName = body.user_name || 'user';\nconst userId = body.user_id || 'unknown';\nreturn [{json: {query: query || 'hello', channelId, userName, userId}}];"
      },
      "id": "7f2edfb5-0d2d-4bdd-b0e2-172562a84de4",
      "name": "Extract Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// 每人每日額度限制（使用 workflow static data 持久化）\nconst staticData = $getWorkflowStaticData('global');\nconst userId = $json.userId;\nconst today = new Date().toISOString().split('T')[0];\nconst DAILY_LIMIT = 50;\n\n// 初始化 rate 資料結構\nif (!staticData.rate) staticData.rate = {};\nconst key = userId;\n\n// 日期變更時重置計數\nif (!staticData.rate[key] || staticData.rate[key].date !== today) {\n  staticData.rate[key] = { date: today, count: 0 };\n}\n\nconst currentCount = staticData.rate[key].count;\nconst isAllowed = currentCount < DAILY_LIMIT;\n\nif (isAllowed) {\n  staticData.rate[key].count = currentCount + 1;\n}\n\nreturn [{json: {\n  ...$json,\n  rateAllowed: isAllowed,\n  rateRemaining: Math.max(0, DAILY_LIMIT - currentCount - (isAllowed ? 1 : 0)),\n  rateCount: currentCount + (isAllowed ? 1 : 0),\n  dailyLimit: DAILY_LIMIT\n}}];"
      },
      "id": "b1a2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
      "name": "Rate Limiter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "id": "rate-check",
              "leftValue": "={{ $json.rateAllowed }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "c2b3a4d5-f6e7-4b8c-9d0e-1f2a3b4c5d6e",
      "name": "IF Rate OK",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        910,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// 簡單意圖路由：關鍵字分類\nconst query = $json.query.toLowerCase();\n\n// 程式碼相關關鍵字（Phase 3 才開放）\nconst codeKeywords = ['review pr', 'write test', 'debug code', 'refactor', 'analyze bug', 'code review', '程式碼審查', '寫測試'];\n// 資料查詢關鍵字（Phase 4 才開放）\nconst dataKeywords = ['query db', 'sql ', 'select from', '查資料庫', '跑報表', '資料庫查詢'];\n\nlet intent = 'general';\n\nfor (const kw of codeKeywords) {\n  if (query.includes(kw)) { intent = 'code'; break; }\n}\nif (intent === 'general') {\n  for (const kw of dataKeywords) {\n    if (query.includes(kw)) { intent = 'data'; break; }\n  }\n}\n\nreturn [{json: { ...$json, intent }}];"
      },
      "id": "d3c4b5a6-e7f8-4c9d-0e1f-2a3b4c5d6e7f",
      "name": "Intent Router",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1130,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "id": "intent-check",
              "leftValue": "={{ $json.intent }}",
              "rightValue": "general",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "e4d5c6b7-f8a9-4d0e-1f2a-3b4c5d6e7f8a",
      "name": "IF General",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1350,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3080/v1/chat-messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer <DIFY_APP_API_KEY>"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ inputs: {}, query: $json.query, response_mode: 'streaming', user: $json.userName }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          },
          "timeout": 120000
        }
      },
      "id": "a57f3416-bcea-449d-a24f-d5f8804c8352",
      "name": "Call Dify API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1570,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// 解析 Dify SSE 串流回應\nconst raw = $input.first().json.data || $input.first().json.body || '';\nconst text = typeof raw === 'string' ? raw : JSON.stringify(raw);\n\nlet answer = '';\nconst lines = text.split('\\n');\nfor (const line of lines) {\n  if (line.startsWith('data: ')) {\n    try {\n      const data = JSON.parse(line.substring(6));\n      if (data.answer) {\n        answer += data.answer;\n      }\n    } catch (e) {}\n  }\n}\n\nif (!answer) {\n  answer = '抱歉，無法處理您的請求。請稍後再試。';\n}\n\nconst channelId = $('Extract Message').first().json.channelId;\nconst userId = $('Extract Message').first().json.userId;\nconst userName = $('Extract Message').first().json.userName;\nconst rateRemaining = $('Rate Limiter').first().json.rateRemaining;\nconst dailyLimit = $('Rate Limiter').first().json.dailyLimit;\nreturn [{json: {answer, channelId, userId, userName, rateRemaining, dailyLimit}}];"
      },
      "id": "153d0de6-bbfb-4e51-acd9-2a10da667649",
      "name": "Parse SSE Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1790,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// 記錄使用統計到 Static Data\nconst staticData = $getWorkflowStaticData('global');\nconst userId = $json.userId;\nconst userName = $json.userName;\n\nif (!staticData.stats) {\n  staticData.stats = { totalRequests: 0, users: {} };\n}\nstaticData.stats.totalRequests++;\n\nif (!staticData.stats.users[userId]) {\n  staticData.stats.users[userId] = { name: userName, total: 0 };\n}\nstaticData.stats.users[userId].total++;\n\n// 透傳原始資料\nreturn [$input.first()];"
      },
      "id": "f5e6d7c8-a9b0-4e1f-2a3b-4c5d6e7f8a9b",
      "name": "Log Usage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2010,
        100
      ]
    },
