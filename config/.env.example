# ============================================
# 企業 AI 平台 — 環境變數範本
# ============================================
# 使用方式：
#   cp .env.example .env
#   編輯 .env 填入實際值
#   docker compose up -d
#
# ⚠️ 務必修改所有標記 changeme 的值
# ⚠️ 切勿將 .env 提交至版本控制
# ============================================

# --- n8n ---
N8N_USER=admin
N8N_PASSWORD=changeme
N8N_HOST=localhost

# --- Redis ---
REDIS_PASSWORD=changeme

# --- PostgreSQL ---
DB_USER=dify
DB_PASSWORD=changeme

# --- Anthropic ---
# 取得方式：https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxx

# --- Slack ---
# 取得方式：https://api.slack.com/apps → 你的 App → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-xxxxx
# 取得方式：https://api.slack.com/apps → 你的 App → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=xxxxx

# --- GitHub（Phase 4）---
# 取得方式：GitHub Settings → Developer settings → Personal access tokens
# GITHUB_TOKEN=ghp_xxxxx

# --- Linear/Jira（Phase 4）---
# LINEAR_API_KEY=lin_api_xxxxx
# JIRA_URL=https://company.atlassian.net
# JIRA_EMAIL=you@company.com
# JIRA_API_TOKEN=xxxxx

# --- Notion（Phase 4）---
# NOTION_API_KEY=ntn_xxxxx

# --- Ollama（Phase 7）---
# OLLAMA_HOST=http://localhost:11434
